        "subject": "=[URGENT] {{ $json.ticket_id }} - {{ $json.topic }} / {{ $json.urgency }}",
        "emailFormat": "text",
        "text": "=A ticket needs immediate human review.\n\nTicket: {{ $json.ticket_id }}\nFrom: {{ $json.customer_email }}\nSubject: {{ $json.subject }}\n\nTopic: {{ $json.topic }}\nUrgency: {{ $json.urgency }}\nSentiment: {{ $json.sentiment }}\nWhy it was flagged: {{ $json.route_reason }}\n\nSummary: {{ $json.summary }}\n\nNo auto-reply was drafted for this ticket.",
        "options": {}
      },
