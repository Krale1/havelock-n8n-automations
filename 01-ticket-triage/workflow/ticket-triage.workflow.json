      "id": "normalize-ticket",
      "name": "Normalize Ticket",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -600,
        300
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "claude-haiku-4-5"
        },
        "messages": {
          "values": [
            {
              "content": "=Subject: {{ $json.subject }}\n\nBody:\n{{ $json.body }}",
              "role": "user"
            }
          ]
        },
        "simplify": true,
        "options": {
          "system": "You are a support ticket triage assistant at Havelock, which makes payroll and bookkeeping software for small businesses (5-50 employees).\nGiven a ticket's subject and body, respond with ONLY valid JSON (no markdown fences, no explanation) with keys: topic, urgency, sentiment, summary.\n\nAllowed values:\n- topic: billing | technical | account | feature_request | complaint | other\n- urgency: low | medium | high | critical\n- sentiment: positive | neutral | negative\n- summary: one sentence, max 25 words, describing the issue.\n\nUrgency thresholds:\n- critical = a payroll run has failed or staff will not be paid on time, money has left an account in error, a security or fraud concern, or an imminent statutory filing deadline.\n- high = the customer is blocked from important work, but nobody is going unpaid and no deadline is imminent.\n- medium = a real problem that has a workaround.\n- low = a question, a request, or feedback.\nAn angry or frustrated tone on its own is NOT critical. Judge urgency on impact, sentiment on tone.\n\nNote: \"billing\" means a problem with the customer's own Havelock subscription. A problem with the customer paying their staff is \"technical\".",
          "maxTokens": 300,
          "temperature": 0,
          "includeMergedResponse": true
        }
      },
      "id": "classify-ticket",
      "name": "Classify Ticket (Claude)",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        -380,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Parse Claude's JSON classification into flat workflow fields.\n// Claude is told to return bare JSON, but we never trust that blindly:\n// fences, stray prose, or an invalid enum must not break the run.\n\nconst ALLOWED = {\n  topic: ['billing', 'technical', 'account', 'feature_request', 'complaint', 'other'],\n  urgency: ['low', 'medium', 'high', 'critical'],\n  sentiment: ['positive', 'neutral', 'negative'],\n};\n\nfunction extractJson(text) {\n  if (!text) return null;\n  let t = String(text).trim();\n  t = t.replace(/^```(?:json)?/i, \"\").replace(/```$/, \"\").trim();\n  const start = t.indexOf('{');\n  const end = t.lastIndexOf('}');\n  if (start === -1 || end === -1 || end <= start) return null;\n  try {\n    return JSON.parse(t.slice(start, end + 1));\n  } catch (err) {\n    return null;\n  }\n}\n\nfunction pick(value, allowed, fallback) {\n  const v = String(value ?? '').trim().toLowerCase();\n  return allowed.includes(v) ? v : fallback;\n}\n\nconst tickets = $('Normalize Ticket').all();\nconst incoming = $input.all();\nconst results = [];\n\nfor (let i = 0; i < incoming.length; i++) {\n  const ticket = tickets[Math.min(i, tickets.length - 1)].json;\n  const parsed = extractJson(incoming[i].json.merged_response);\n\n  // Fail safe: if we could not classify it, a human looks at it.\n  // Silently auto-replying to an unclassified ticket is the worse failure.\n  if (!parsed) {\n    results.push({\n      json: {\n        ...ticket,\n        topic: 'other',\n        urgency: 'critical',\n        sentiment: 'neutral',\n        summary: 'Automatic classification failed - model output was not valid JSON.',\n        classification_ok: false,\n        route_reason: 'classification_failed_fail_safe_to_human',\n      },\n      pairedItem: { item: i },\n    });\n    continue;\n  }\n\n  const topic = pick(parsed.topic, ALLOWED.topic, 'other');\n  const urgency = pick(parsed.urgency, ALLOWED.urgency, 'medium');\n  const sentiment = pick(parsed.sentiment, ALLOWED.sentiment, 'neutral');\n  const summary = String(parsed.summary ?? '').trim() || 'No summary returned.';\n\n  let route_reason = 'standard_queue';\n  if (urgency === 'critical') {\n    route_reason = 'urgency_is_critical';\n  } else if (sentiment === 'negative' && urgency === 'high') {\n    route_reason = 'negative_sentiment_and_high_urgency';\n  }\n\n  results.push({\n    json: { ...ticket, topic, urgency, sentiment, summary, classification_ok: true, route_reason },\n    pairedItem: { item: i },\n  });\n}\n\nreturn results;"
      },
      "id": "parse-classification",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-critical",
              "leftValue": "={{ $json.urgency }}",
              "rightValue": "critical",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-negative-high",
              "leftValue": "={{ $json.sentiment === 'negative' && $json.urgency === 'high' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "or"
        },
        "looseTypeValidation": false,
        "options": {}
      },
