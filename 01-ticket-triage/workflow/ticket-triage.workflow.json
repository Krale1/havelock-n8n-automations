        },
        "messages": {
          "values": [
            {
              "content": "=Ticket subject: {{ $json.subject }}\n\nTicket body:\n{{ $json.body }}\n\nTriage result - topic: {{ $json.topic }}, urgency: {{ $json.urgency }}, sentiment: {{ $json.sentiment }}\nOne-line summary: {{ $json.summary }}",
              "role": "user"
            }
          ]
        },
        "simplify": true,
        "options": {
          "system": "You are a support agent at Havelock, which makes payroll and bookkeeping software for small businesses.\nDraft a first reply to the customer: short (max 120 words), polite, acknowledging the specific issue and stating the next step.\n\nHard rules. You have no access to any live system, so you cannot verify anything:\n- Never confirm that a refund, credit, cancellation, or subscription change has been made.\n- Never state that a payroll run has been corrected, re-run, or completed.\n- Never confirm that a payment, bank sync, or statutory filing has gone through.\n- Never give tax, accounting, payroll-compliance, or financial advice of any kind.\n- Never invent amounts, dates, reference numbers, deadlines, or policy details.\n- Never promise a specific resolution time.\n\nIf the issue needs account access or involves money movement, say that a support specialist will review it and follow up directly.\n\nReturn only the reply text. No subject line, no preamble. End with 'Best regards,' then 'Havelock Support'.",
          "maxTokens": 400,
          "temperature": 0.3,
          "includeMergedResponse": true
        }
      },
